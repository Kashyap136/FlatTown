# =============================================================================
# FLAT TOWN — combined template for local development
#
# This file documents the FULL set of variables for the whole product. The API
# reads `server/.env`; the web app reads `web/.env.local`.
#
# NEVER commit a populated .env file — only .env.example is versioned.
# =============================================================================

# ============================== shared ======================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
NODE_ENV=development
LOG_LEVEL=debug

# ============================== database ====================================
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/flattown?retryWrites=true&w=majority

# ================================= auth =====================================
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-plus
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# =============================== payments ====================================
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ESCROW_ACCOUNT_ID=flattown-escrow
# Development only. Refused outright when NODE_ENV=production.
ALLOW_MOCK_PAYMENTS=true
MOCK_PAYMENT_KEY=change-me-mock-payment-key

# ================================ pricing ===================================
# These seed PlatformConfig, which an admin can then change at runtime via
# PUT /admin/commission-config. Names must match server/src/config/env.ts.
TIER_BUDGET=5000000
TIER_MID=15000000
# Fraction: 0.10 = 10% of the booking TOKEN (never of the flat price).
# The legacy percent form COMMISSION_PERCENT=10 is also accepted.
COMMISSION=0.10
# Platform share of the commission when an agent is involved (agent gets 30%).
AGENT_PLATFORM_PERCENT=70
DEFAULT_TOKEN_AMOUNT=50000
DEFAULT_VISIT_CHARGE=199

# ================================= cache =====================================
REDIS_URL=redis://localhost:6379

# =============================== storage ====================================
# Option A (preferred): a single URL.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Option B (alternative): separate credentials. CLOUDINARY_URL takes precedence
# if both forms are supplied.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=flattown

# ================================ email =====================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Flat Town <no-reply@flattown.in>"

# ================================== sms =====================================
SMS_PROVIDER=log

# ============================== web (public) ===============================
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_TOKEN=