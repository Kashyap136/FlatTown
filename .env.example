# =============================================================================
# FLAT TOWN — combined template for local development
#
# This file documents the FULL set of variables for the whole product. The API
# reads `server/.env`; the web app reads `web/.env.local`.
#
# NEVER commit a populated .env file — only .env.example is versioned.
# =============================================================================

# ============================== shared ======================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
NODE_ENV=development
LOG_LEVEL=debug

# ============================== database ====================================
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/flattown?retryWrites=true&w=majority

# ================================= auth =====================================
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-plus
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# =============================== payments ====================================
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ESCROW_ACCOUNT_ID=flattown-escrow
# Development only. Refused outright when NODE_ENV=production.
ALLOW_MOCK_PAYMENTS=true
MOCK_PAYMENT_KEY=change-me-mock-payment-key

# ================================ pricing ===================================
TIER_BUDGET=5000000
TIER_MID=15000000
COMMISSION=0.10
AGENT_PLATFORM_PERCENT=70
TOKEN_AMOUNTS=50000,100000,200000,500000

# ================================= cache =====================================
REDIS_URL=redis://localhost:6379

# =============================== storage ====================================
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=flattown

# ================================ email =====================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Flat Town <no-reply@flattown.in>"

# ================================== sms =====================================
SMS_PROVIDER=log

# ============================== web (public) ===============================
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_TOKEN=