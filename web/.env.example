# =============================================================================
# FLAT TOWN — web environment (web/)
# Copy to `.env.local` in `web/`. NEVER commit a populated .env.local file.
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser. Nothing
# here is a secret — every secret lives in the API's environment.
# =============================================================================

# Base URL of the Flat Town API, including the version prefix is appended by
# the client. Leave unset to use http://localhost:5000/api/v1.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Absolute origin of this deployment. Used for canonical URLs, Open Graph tags
# and sitemap generation. In production this is your Vercel domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Mapbox access token (pk.*). Without it the map falls back to a static
# panel with a Google Maps / OpenStreetMap deep link, clearly labelled.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional: expose the Razorpay checkout key when the API does not return one.
# Normally the API returns `keyId` with the created order, so this is rarely
# needed.
NEXT_PUBLIC_RAZORPAY_KEY_ID=