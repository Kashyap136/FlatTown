# =============================================================================
# FLAT TOWN — API environment (server/)
# Copy to `.env` and fill in. NEVER commit a populated .env file.
# =============================================================================

# ---------------------------------------------------------------- runtime ----
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
# Public origin of the API, used in webhook and email links.
BACKEND_URL=http://localhost:5000
# Comma-separated list of allowed browser origins.
FRONTEND_URL=http://localhost:3000

# --------------------------------------------------------------- database ----
# MongoDB Atlas. Create a free M0 cluster, add a database user, and allow your
# Render/Vercel egress IPs or 0.0.0.0/0 for development.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/flattown?retryWrites=true&w=majority

# ------------------------------------------------------------------- auth ----
# Use `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# for each. Never reuse the same value for access and refresh.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-32-plus
# Access token lifetime / refresh token lifetime.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=10

# ---------------------------------------------------------------- payments ----
# Razorpay dashboard → Settings → API Keys.
# Leave BOTH blank to use the clearly-labelled simulated development gateway.
RAZORPAY_KEY=
RAZORPAY_SECRET=
# Webhook secret (Settings → Webhooks). Required for real webhook verification.
RAZORPAY_WEBHOOK_SECRET=
# Escrow account reference recorded on every booking for reconciliation.
ESCROW_ACCOUNT_ID=flattown-escrow

# ------------------------------------------- simulated payments (DEV ONLY) ----
# The mock gateway is refused outright when NODE_ENV=production.
ALLOW_MOCK_PAYMENTS=true
# Signing key used only to sign simulated callbacks in development.
MOCK_PAYMENT_KEY=change-me-mock-payment-key

# ----------------------------------------------------------------- pricing ----
# Default tier thresholds in whole rupees. An admin can change these at runtime
# from the admin panel — these values are only the boot-time defaults.
TIER_BUDGET=5000000
TIER_MID=15000000
# Platform commission on the BOOKING TOKEN only.
COMMISSION=0.10
# When an agent is involved: platform share of the commission, percent.
AGENT_PLATFORM_PERCENT=70
# Allowed booking token amounts, whole rupees.
TOKEN_AMOUNTS=50000,100000,200000,500000

# ------------------------------------------------------------------- cache ----
# Redis. Optional — the API degrades to running without cache. Financial
# operations never depend on it.
REDIS_URL=redis://localhost:6379
FLAT_DISCOVERY_CACHE_TTL=300

# ----------------------------------------------------------------- storage ----
# Cloudinary connection string: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Leave blank in development to store files under ./uploads (never in MongoDB).
CLOUDINARY_URL=
CLOUDINARY_FOLDER=flattown
# S3-compatible fallback, used when CLOUDINARY_URL is empty.
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------- email ----
# Nodemailer SMTP. Leave blank in development: emails are logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Flat Town <no-reply@flattown.in>"

# --------------------------------------------------------------------- SMS ----
# The SMS layer is a provider abstraction. Register a real adapter at boot with
# `registerSmsProvider()`; until then messages are logged.
SMS_PROVIDER=log

# --------------------------------------------------------------------- SMS ----
LOGIN_PARTNER_PHONE=