{
  "name": "flat-town-server",
  "version": "1.0.0",
  "private": true,
  "description": "Flat Town API — new builder flats marketplace backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint",
    "seed:amenities": "tsx src/seed/seedAmenities.ts",
    "seed:cities": "tsx src/seed/seedCities.ts",
    "seed:all": "tsx src/seed/seedAll.ts",
    "seed:users": "tsx src/seed/seedUsers.ts",
    "test": "node scripts/test.mjs",
    "test:one": "node --test --import tsx test/",
    "test:redis": "node --test --import tsx --test-concurrency=1 test/redis-cache.integration.ts",
    "verify:boot": "npm run build && node scripts/verify-render-boot.mjs",
    "test:smoke": "node --import tsx scripts/smoke-seeded.cjs",
    "test:e2e": "node scripts/e2e-funnel.mjs",
    "audit:ids": "node scripts/audit-ids.mjs",
    "audit:contract": "node scripts/audit-client-contract.mjs",
    "audit:encoding": "node scripts/inventory-nonascii.cjs src ../web ../docs",
    "audit:indexes": "node scripts/find-duplicate-indexes.cjs",
    "audit:secrets": "node scripts/audit-secrets.cjs src test scripts ../web/app ../web/components ../web/lib ../web/hooks ../web/store ../docs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run audit:indexes && npm run audit:secrets"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nanoid": "^3.3.7",
    "nodemailer": "^6.9.15",
    "razorpay": "^2.9.6",
    "redis": "^4.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.16",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.7",
    "supertest": "^7.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=18"
  }
}
